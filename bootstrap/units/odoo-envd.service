[Unit]
Description=odoo-envd CD engine (Odoo branch environments)
Documentation=file:///home/odoo/Projects/odoo-envd/docs/ops-runbook.md
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/odoo/Projects/odoo-envd
ExecStart=/home/odoo/Projects/odoo-envd/.venv/bin/envd serve --config /etc/odoo-envd/envd.toml
Restart=on-failure
RestartSec=5
User=root
# the engine talks to docker, git, psql (inside containers) and writes /srv/odoo

[Install]
WantedBy=multi-user.target
