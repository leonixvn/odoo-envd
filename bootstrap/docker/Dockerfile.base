# Base image: the pinned official odoo image plus build tools for per-env
# pip deps layers (envd-env-<slug> images built by the deploy flow).
# The image tag in envd.example.toml [docker] base_image must match what is
# built here — bootstrap.sh builds it as envd-base:20; pin the FROM tag by
# DATE so nightly rebuilds never change a running fleet silently.
FROM odoo:20.0-20261112

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libxml2-dev \
        libxslt1-dev \
        libjpeg-dev \
        zlib1g-dev \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*
USER odoo
